{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "buildCommand": "",
  "installCommand": "",
  "functions": {
    "api/index.py": {
      "includeFiles": "server.py"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?endpoint=:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
